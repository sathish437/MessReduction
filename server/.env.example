PORT=8080
SPRING_DATABASE_URL=jdbc:postgresql://localhost:5432/MessReduction
SPRING_DATABASE_USERNAME=postgres
SPRING_DATABASE_PASSWORD=your_database_password
JWT_SECRET=your_jwt_secret_min_32_characters_long
JWT_EXPIRATION=86400000
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:3000
STUDENT_VERIFY_API_URL=https://example.com/api/auth/verify-details
STUDENT_VERIFY_API_KEY=your_verification_api_key
STUDENT_VERIFY_ENABLED=true
VAPID_PUBLIC_KEY=your_vapid_public_key
VAPID_PRIVATE_KEY=your_vapid_private_key
VAPID_SUBJECT=mailto:admin@example.com
NOTIFICATION_BATCH_ENABLED=true
NOTIFICATION_BATCH_INTERVAL=30
NOTIFICATION_REMINDER_ENABLED=true
NOTIFICATION_REMINDER_INTERVAL_HOURS=1
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_CLIENT_EMAIL=your_firebase_client_email
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nyour_private_key\n-----END PRIVATE KEY-----\n"
